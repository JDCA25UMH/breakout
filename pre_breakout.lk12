LK12;OSData;DiskOS;DiskGame;V4;API_2;192x128;C:none;CLvl:0;
___luacode___
Controls("touch")
cursor("point")

function _init()


end
local game ={
state  = {
juego = true,
ended = false

}
}

local Clase ={}
Clase.__index = Clase
function Clase.new(n,x,y,w)
return setmetatable({num=n,
x=x,y=y,w=w}, Clase)
end

paddle ={}
paddle[1]= Clase.new(1,0,45,22)

move_ball = 0
m = 0 
function Clase:move(minX,maxX)
 if btnp(2) then
 self.x= math.min(self.x+5,maxX)
 
 move_ball =math.min(move_ball +1,11)
 elseif btnp(1)then
 self.x = math.max(self.x-5,minX)
 move_ball =math.max(move_ball-1,0)
 end
end


lanze = false
tope_techo = 15 
circulo = {x=0, y=0, w = 3, h=3}

pared_izq= false
pared_der = false
techo = false


local function angulo(move_ball)
return ({155,141,128,115,102,80,
77,64,51,38,25,12})[move_ball+1]
end


function circulus(circulo_x,circulo_y)
local ang = angulo(move_ball)
local cos_x =
 math.cos(math.rad(ang))
local sen_y= 
math.sin(math.rad(ang))
if not lanze then 

 
 circulo.x = paddle[1].x+11+
 (move_ball*10)
  circulo.y =100 
 
end

return circulo.x, circulo.y,
 cos_x ,sen_y
end

function collision()

if lanze then 

if circulo.x<= 3 or circulo.x>=189 then

cos_x = -cos_x
end

if circulo.y<=20 then 
sen_y = -sen_y
end

pad = paddle[1].x+(move_ball*10)
 if circulo.y>=100 then 
if circulo.x >= pad
and circulo.x<=pad+22 then
sen_y = -sen_y
end
end
end

end

local Cuadrado = {}
Cuadrado.__index = Cuadrado
function Cuadrado.new(x,y,w,h,clr,
aparece,golpe_ball)
local instancia = 
 setmetatable({x=x,y=y
,w=w,h=h,clr=clr},Cuadrado)
setmetatable(instancia,Cuadrado)
instancia.aparece= aparece
instancia.golpe_ball = golpe_ball
instancia.golpes = 0 
return instancia
end

tabl ={}

for i=1 , 6 do
tabl[i]= Cuadrado.new(i*25,50,
20,10,12,true,false)
end

tabl2 = {}

for i = 1, 6 do 
tabl2[i]=Cuadrado.new(i*25,30,
20,10,9,
true,false)
end

function collision_bc(circulo_x,
circulo_y,circulo_width,
circulo_height,
cdr_x,cdr_y,
cdr_width,cdr_height)

if circulo_x +circulo_width> cdr_x and
circulo_x< cdr_x+cdr_width and
circulo_y+circulo_height > cdr_y and
circulo_y<cdr_y +cdr_height then
return true
else
return false
end
end
local m = 0 
 
function Cuadrado:cero()
local col = collision_bc(circulo.x,
circulo.y,circulo.w,circulo.h,
self.x,self.y,self.w,
self.h)

if col and not
self.golpe_ball then
self.golpe_ball = true
self.golpes = self.golpes+1
if self.aparece then 
sen_y = -sen_y
end

if self.golpes >= 2 then 
 self.aparece = false
end
if self.aparece == false and 
self.golpes == 2  then 
m = m +1
end
elseif not col then 
self.golpe_ball = false

end
end


function _update()

x,y = getMPos()
paddle[1]:move(0,55)
if lanze == false then 
circulo.x,circulo.y,cos_x,sen_y = 
circulus(circulo.x, circulo.y)

else
circulo.x = circulo.x+cos_x
circulo.y = circulo.y-sen_y
collision()

end

for i,v in ipairs(tabl)do
v:cero()
end

for i,v in ipairs(tabl2)do
v:cero()
end

end

function _keypressed(key)
if key == "space"then 
lanze = true
end
end

function _draw()

if game.state["juego"]then 
cam()
cam("scale",3,2)
clear()

Sprite(1,paddle[1].x,paddle[1].y)

cam()

circulus(circulo_x, circulo_y)
color(7)
circle(circulo.x, circulo.y,3)

for i,v in ipairs(tabl)do
 if tabl[i].aparece then 
color(tabl[i].clr)
rect(tabl[i].x,tabl[i].y,
tabl[i].w,tabl[i].h)
end
end
 
 for i,v in ipairs(tabl2)do
 
 if tabl2[i].aparece then
 color(tabl2[i].clr)
 rect(tabl2[i].x,tabl2[i].y,
 tabl2[i].w,tabl2[i].h)
 end
 end
if circulo.y>= 128 then 
game.state["ended"]= true
game.state["juego"]=false
end


color(7)
print("Score:",50,5)
print(m,90,5)


elseif game.state["ended"]then 
clear()
color(7)
print("GAME OVER",50,50)
end

end
